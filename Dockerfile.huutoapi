FROM python:3.14.10-alpine3.24 AS builder

COPY --from=ghcr.io/astral-sh/uv:0.11.3 /uv /uvx /bin/

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv-huutoapi
COPY uv.lock pyproject.toml ./

RUN rm -rf /opt/venv-huutoapi
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --no-install-project --no-dev --extra huutoapi
COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra huutoapi

FROM python:3.14.10-alpine3.24 AS runtime

ENV PATH="/opt/venv-huutoapi/bin:$PATH"

RUN addgroup -S appgroup && adduser -S appuser -G appgroup
WORKDIR /app
COPY --from=builder --chown=appuser:appgroup /opt/venv-huutoapi /opt/venv-huutoapi
COPY --from=builder --chown=appuser:appgroup /app /app

USER appuser
ENTRYPOINT ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]