FROM python:3.14.10-alpine3.24 AS builder

COPY --from=ghcr.io/astral-sh/uv:0.11.3 /uv /uvx /bin/

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv-huutomcp
COPY uv.lock pyproject.toml ./

RUN rm -rf /opt/venv-huutoapi
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --no-install-project --no-dev --extra huutomcp
COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra huutomcp

FROM python:3.14.10-alpine3.24 AS runtime

ENV PATH="/opt/venv-huutomcp/bin:$PATH"

RUN addgroup -S appgroup && adduser -S appuser -G appgroup
WORKDIR /app
COPY --from=builder --chown=appuser:appgroup /opt/venv-huutomcp /opt/venv-huutomcp
COPY --from=builder --chown=appuser:appgroup /app /app

ENTRYPOINT ["fastmcp", "run"]
CMD ["mcpserver.py", "--transport", "http", "--host", "0.0.0.0", "--port", "8000"]
